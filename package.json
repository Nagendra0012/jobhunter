{
  "name": "jobhunter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "app": "next build && next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "daily": "node --conditions=react-server --import tsx scripts/daily.mts",
    "known-jobs": "node --conditions=react-server --import tsx scripts/known-jobs.mts",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "docx": "^9.15.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
